# One shared Convex deployment for all machines. No deployment/admin key here.
CONVEX_URL=https://your-deployment.convex.cloud
# Generate once; set the same value as AGENTBUS_SECRET in the Convex backend.
AGENTBUS_SECRET=replace-with-a-long-random-value
# Use a different name for each agent's MCP process.
AGENTBUS_AGENT=manager
